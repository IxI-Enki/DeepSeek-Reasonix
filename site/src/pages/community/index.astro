---
import Community from "../../layouts/Community.astro";
import { QQ_GROUP, DISCORD_URL, DOUYIN } from "../../lib/community-links.mjs";
---
<Community title="Reasonix Community" description="Ask questions, share skills, and shape a DeepSeek-native agent." active="discussions">
  <div class="wrap forum">
    <aside class="fnav" aria-label="Forum navigation">
      <a class="btn btn-primary fnew" href="/community/new/"><span class="l-en">✎ New topic</span><span class="l-zh">✎ 发起话题</span></a>
      <nav class="fmenu" id="sort-tabs" aria-label="Topic lists">
        <button class="on" data-sort="latest"><span class="l-en">Latest</span><span class="l-zh">最新</span></button>
        <button data-sort="top"><span class="l-en">Top</span><span class="l-zh">热门</span></button>
        <button data-sort="unanswered"><span class="l-en">Unanswered</span><span class="l-zh">未回复</span></button>
      </nav>
      <h5 class="fh"><span class="l-en">Categories</span><span class="l-zh">分区</span></h5>
      <nav class="fcats" id="cat-list" aria-label="Categories">
        <a class="fcat" href="/community/"><i class="dot" data-cat=""></i><span class="nm"><span class="l-en">Loading…</span><span class="l-zh">加载中…</span></span></a>
      </nav>
      <h5 class="fh"><span class="l-en">Community</span><span class="l-zh">社区</span></h5>
      <nav class="flinks">
        <a href="/community/guidelines/"><span class="l-en">Guidelines</span><span class="l-zh">社区规范</span></a>
        <a href={QQ_GROUP.joinUrl} target="_blank" rel="noreferrer"><span class="l-en">QQ group</span><span class="l-zh">QQ 群</span> <code>{QQ_GROUP.number}</code></a>
        <a href={DISCORD_URL} target="_blank" rel="noreferrer">Discord</a>
        <a href="/docs/"><span class="l-en">Documentation ↗</span><span class="l-zh">文档 ↗</span></a>
      </nav>
      <p class="fstat"><span id="s-topics">—</span> <span class="l-en">topics</span><span class="l-zh">话题</span> · <span id="s-cats">—</span> <span class="l-en">categories</span><span class="l-zh">分区</span></p>
    </aside>

    <main class="fmain">
      <div class="fbar">
        <div class="ftitle">
          <h1 id="f-title"><span class="l-en">All topics</span><span class="l-zh">全部话题</span></h1>
          <p id="f-desc"></p>
        </div>
        <label class="fsearch"><span class="l-en sr">Filter topics</span><span class="l-zh sr">筛选话题</span>
          <input id="t-search" type="search" autocomplete="off" placeholder="Filter topics…" data-ph-zh="筛选话题…" />
        </label>
      </div>
      <div class="ftable" role="table" aria-label="Topics">
        <div class="fhead" role="row">
          <span role="columnheader"><span class="l-en">Topic</span><span class="l-zh">话题</span></span>
          <span role="columnheader" class="num"><span class="l-en">Replies</span><span class="l-zh">回复</span></span>
          <span role="columnheader" class="num"><span class="l-en">Views</span><span class="l-zh">浏览</span></span>
          <span role="columnheader" class="act"><span class="l-en">Activity</span><span class="l-zh">活动</span></span>
        </div>
        <div id="topic-list" class="topics" role="rowgroup">
          <div class="skeleton"><div class="bar"></div><div class="bar short"></div></div>
          <div class="skeleton"><div class="bar"></div><div class="bar short"></div></div>
          <div class="skeleton"><div class="bar"></div><div class="bar short"></div></div>
        </div>
      </div>
    </main>
  </div>
</Community>
