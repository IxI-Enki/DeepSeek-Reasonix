---
import Account from '../layouts/Account.astro';
import PasswordInput from '../components/PasswordInput.astro';
---
<Account
  wide
  dash
  title="Your account — Reasonix"
  titleEn="Your account — Reasonix"
  titleZh="我的账号 — Reasonix"
  description="Manage your Reasonix account.">
  <div id="account-gate" class="auth-head">
    <p><span class="l-en">Loading your account…</span><span class="l-zh">正在加载账号…</span></p>
  </div>

  <div id="account-view" hidden>
    <div class="acct-id">
      <span id="acct-avatar" class="acct-avatar" aria-hidden="true"></span>
      <div class="acct-who">
        <div id="acct-name" class="acct-name-big"></div>
        <div id="acct-handle" class="acct-handle"></div>
        <div id="acct-email" class="acct-email"></div>
        <div class="acct-chips">
          <span id="acct-role" class="acct-role"></span>
          <span id="acct-verified" class="acct-chip"></span>
          <span id="acct-joined" class="acct-chip"></span>
        </div>
      </div>
      <a id="acct-profile-link" class="btn btn-ghost sm" href="/u/"><span class="l-en">Public profile</span><span class="l-zh">公开主页</span></a>
    </div>

    <div id="acct-overview" class="acct-grid" role="group" aria-label="Overview">
      <article class="acct-card" id="card-forum">
        <h3><span class="l-en">Community</span><span class="l-zh">社区</span></h3>
        <div class="acct-level"><span id="forum-level" class="acct-lv">—</span><span id="forum-level-note" class="acct-note"></span></div>
        <dl class="acct-stats">
          <div><dt><span class="l-en">Topics</span><span class="l-zh">话题</span></dt><dd id="st-topics">—</dd></div>
          <div><dt><span class="l-en">Replies</span><span class="l-zh">回复</span></dt><dd id="st-posts">—</dd></div>
          <div><dt><span class="l-en">Likes</span><span class="l-zh">获赞</span></dt><dd id="st-likes">—</dd></div>
          <div><dt><span class="l-en">Solved</span><span class="l-zh">已解决</span></dt><dd id="st-solved">—</dd></div>
        </dl>
        <p id="forum-perms" class="acct-note"></p>
        <ul id="forum-recent" class="acct-recent"></ul>
        <a class="acct-more" href="/community/"><span class="l-en">Open the forum →</span><span class="l-zh">进入论坛 →</span></a>
      </article>

      <article class="acct-card" id="card-feedback">
        <h3><span class="l-en">Feedback level</span><span class="l-zh">反馈等级</span></h3>
        <p class="acct-big" id="fb-level">—</p>
        <div id="fb-track" class="acct-track" hidden><i id="fb-fill"></i></div>
        <p class="acct-note" id="fb-note"></p>
        <p class="acct-note" id="fb-limits"></p>
        <ul id="fb-installs" class="acct-recent"></ul>
        <ul id="fb-items" class="acct-recent"></ul>
      </article>

      <article class="acct-card" id="card-devices">
        <h3><span class="l-en">Devices</span><span class="l-zh">设备</span></h3>
        <p class="acct-big"><span id="dev-total">—</span> <span class="acct-unit"><span class="l-en">registered</span><span class="l-zh">台已注册</span></span></p>
        <p class="acct-note" id="dev-online"></p>
        <a class="acct-more" href="/remote/"><span class="l-en">Open Web Studio →</span><span class="l-zh">进入网页版 Studio →</span></a>
      </article>

      <article class="acct-card" id="card-backups">
        <h3><span class="l-en">Config backups</span><span class="l-zh">配置备份</span></h3>
        <p class="acct-big"><span id="bk-total">—</span> <span class="acct-unit"><span class="l-en">saved</span><span class="l-zh">份</span></span></p>
        <p class="acct-note"><span class="l-en">Back up and restore your Studio settings from Studio.</span><span class="l-zh">在 Studio 里备份和恢复你的设置。</span></p>
      </article>
    </div>

    <div id="verification-wrap" hidden>
      <h2 class="acct-h2"><span class="l-en">Email verification</span><span class="l-zh">邮箱验证</span></h2>
      <div id="verification-msg" class="auth-msg" hidden></div>
      <p class="hint"><span class="l-en">Your email is not confirmed. Some community actions remain locked.</span><span class="l-zh">你的邮箱尚未验证，部分社区操作仍不可用。</span></p>
      <button id="resend-verification-btn" type="button" class="btn btn-ghost"><span class="l-en">Resend verification email</span><span class="l-zh">重新发送验证邮件</span></button>
    </div>

    <h2 class="acct-h2"><span class="l-en">Profile</span><span class="l-zh">资料</span></h2>
    <div id="profile-msg" class="auth-msg" hidden></div>
    <form id="profile-form" class="auth-form" novalidate>
      <div class="field">
        <label for="f-displayName"><span class="l-en">Display name</span><span class="l-zh">显示名</span></label>
        <input id="f-displayName" type="text" maxlength="80" />
      </div>
      <div class="field">
        <label for="f-handle"><span class="l-en">Handle</span><span class="l-zh">用户名</span></label>
        <input id="f-handle" type="text" minlength="3" maxlength="30" />
        <span class="hint"><span class="l-en">Your public profile is linked above.</span><span class="l-zh">你的公开主页链接显示在上方。</span></span>
      </div>
      <div class="field">
        <label for="f-bio"><span class="l-en">Bio</span><span class="l-zh">简介</span></label>
        <textarea id="f-bio" rows="3" maxlength="500"></textarea>
      </div>
      <div class="field">
        <label for="f-avatarUrl"><span class="l-en">Avatar URL</span><span class="l-zh">头像链接</span></label>
        <input id="f-avatarUrl" type="url" maxlength="500" />
      </div>
      <button type="submit" class="btn btn-dark"><span class="l-en">Save profile</span><span class="l-zh">保存资料</span></button>
    </form>

    <h2 class="acct-h2"><span class="l-en">Password</span><span class="l-zh">密码</span></h2>
    <div id="password-msg" class="auth-msg" hidden></div>
    <form id="password-form" class="auth-form" novalidate>
      <div class="field">
        <label for="currentPassword"><span class="l-en">Current password</span><span class="l-zh">当前密码</span></label>
        <PasswordInput id="currentPassword" autocomplete="current-password" required />
      </div>
      <div class="field">
        <label for="newPassword"><span class="l-en">New password</span><span class="l-zh">新密码</span></label>
        <PasswordInput id="newPassword" autocomplete="new-password" minlength={8} required />
      </div>
      <button type="submit" class="btn btn-ghost"><span class="l-en">Change password</span><span class="l-zh">修改密码</span></button>
    </form>

    <h2 class="acct-h2"><span class="l-en">Web Studio</span><span class="l-zh">网页版 Studio</span></h2>
    <p class="hint"><span class="l-en">Use the full Studio interface from this browser and control a computer signed in to the same account.</span><span class="l-zh">在浏览器中使用完整的 Studio 界面，并控制已登录同一账号的电脑。</span></p>
    <a class="btn btn-ghost acct-remote" href="/remote/"><span class="l-en">Enter Web Studio</span><span class="l-zh">进入网页版 Studio</span></a>

    <div class="acct-foot">
      <button id="logout-btn" type="button" class="btn btn-ghost"><span class="l-en">Sign out</span><span class="l-zh">退出登录</span></button>
      <button id="delete-btn" type="button" class="acct-danger"><span class="l-en">Delete account</span><span class="l-zh">注销账号</span></button>
    </div>
  </div>
<script>import "../scripts/account-overview.js";</script>
</Account>
